{
    "name": "tezmanian/utils-str",
    "type": "library",
    "description": "Focused PHP string utilities: case conversion, template interpolation, masking, cryptographically secure random strings, URL slugs, and multibyte-aware truncation. PHP 8.3+, no dependencies.",
    "keywords": [
        "string",
        "slug",
        "mask",
        "random",
        "php"
    ],
    "homepage": "https://github.com/tezmanian/tez-utils-str",
    "license": "MIT",
    "authors": [
        {
            "name": "René Halberstadt",
            "email": "tezmanian@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/tezmanian/tez-utils-str/issues",
        "source": "https://github.com/tezmanian/tez-utils-str"
    },
    "autoload": {
        "psr-4": {
            "Tezmanian\\Utils\\Str\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tezmanian\\Utils\\Tests\\Str\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "jetbrains/phpstorm-attributes": "^1.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse",
        "test": "phpunit --testsuite Unit --colors=always"
    }
}
